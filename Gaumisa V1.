InfoLabel.Parent = Container

task.spawn(function()
    IntroSound:Play()
    TweenService:Create(TextLabel, TweenInfo.new(2), {TextTransparency = 0}):Play()
    
    local startTime = tick()
    while tick() - startTime < 60 and not skipped do
        TextLabel.TextColor3 = Color3.fromHSV((tick() % 3) / 3, 0.8, 1)
        task.wait(0.1)
    end
    
    TweenService:Create(BgFrame, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
    TweenService:Create(TextLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    SkipBtn.Visible = false
    task.wait(1)
    BgFrame:Destroy()
    
    MainMenu.Visible = true
end)
