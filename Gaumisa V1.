InfoLabel.Size = UDim2.new(1, 0, 0, 30)
InfoLabel.Position = UDim2.new(0, 0, 0, 120)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "Gaumisa Hub v1 | Dev: Phát (GaumisaUwU5652)"
