-- [PHẦN 3/6] Main Menu Frame & Dragging
local MainMenu = Instance.new("Frame")
MainMenu.Name = "MainMenu"
MainMenu.Size = UDim2.new(0, 520, 0, 340)
MainMenu.Position = UDim2.new(0.5, -260, 0.5, -170)
