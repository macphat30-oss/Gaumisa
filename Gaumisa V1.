MenuStroke.Color = Color3.fromRGB(255, 215, 0)
MenuStroke.Thickness = 2
MenuStroke.Parent = MainMenu

local dragging, dragStart, startPos
MainMenu.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainMenu.Position
    end
end)

MainMenu.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
-- [PHẦN 4/6] Player Features
local Container = Instance.new("Frame")
Container.Size = UDim2.new(1, -20, 1, -60)
Container.Position = UDim2.new(0, 10, 0, 50)
Container.BackgroundTransparency = 1
Container.Parent = MainMenu

local function CreateButton(text, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.48, 0, 0, 38)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansSemibold
    btn.TextSize = 15
    btn.Parent = Container
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    
    btn.MouseButton1Click:Connect(function() callback(btn) end)
    return btn
end

local godEnabled = false
CreateButton("God Mode: OFF", UDim2.new(0, 0, 0, 10), function(btn)
    godEnabled = not godEnabled
    btn.Text = "God Mode: " .. (godEnabled and "ON" or "OFF")
    btn.TextColor3 = godEnabled and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(255, 255, 255)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.MaxHealth = godEnabled and math.huge or 100
        LocalPlayer.Character.Humanoid.Health = godEnabled and math.huge or 100
    end
end)

CreateButton("FlyGui V3", UDim2.new(0.52, 0, 0, 10), function()
    loadstring(game:HttpGet("https://raw.githubusercontent.com/XNEKO-SCRIPTS/FlyGuiV3/main/FlyGuiV3.lua"))()
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainMenu.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
-- [PHẦN 5/6] Combat & Visual Features
local espEnabled = false
CreateButton("ESP Box: OFF", UDim2.new(0, 0, 0, 60), function(btn)
    espEnabled = not espEnabled
    btn.Text = "ESP Box: " .. (espEnabled and "ON" or "OFF")
    btn.TextColor3 = espEnabled and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(255, 255, 255)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if espEnabled and not plr.Character:FindFirstChild("Highlight") then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 215, 0)
                hl.Parent = plr.Character
            elseif not espEnabled and plr.Character:FindFirstChild("Highlight") then
                plr.Character.Highlight:Destroy()
            end
        end
    end
end)

local hitboxSize = 2
CreateButton("Hitbox Expander: OFF", UDim2.new(0.52, 0, 0, 60), function(btn)
    hitboxSize = (hitboxSize == 2) and 12 or 2
    btn.Text = "Hitbox: " .. (hitboxSize > 2 and "BIG (12x)" or "OFF")
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            plr.Character.HumanoidRootPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            plr.Character.HumanoidRootPart.Transparency = 0.7
        end
    end
end)
