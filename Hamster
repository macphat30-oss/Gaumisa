local function playYouTube(ytId)
    ytId = ytId:match("([%w_%-]+)$") or ytId
    ytId = ytId:gsub("[^%w_%-]", "")
    if YT_TABLE[ytId] then
        playS(YT_TABLE[ytId])
        return
    end
    local ok, res = pcall(function()
        return game:HttpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. ytId)
    end)
    if ok and res then
        local rid = res:match('"audioId":(%d+)')
        if rid then
            playS(rid)
        else
            playS(ytId)
        end
    else
        playS(ytId)
    end
end

