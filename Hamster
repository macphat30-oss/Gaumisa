local function switchPage(f, t, dir) 
    f.Visible = true
    t.Position = dir == "right" and UDim2.new(1, 0, 0, 0) or UDim2.new(-1, 0, 0, 0) 
    t.Visible = true 
    TS:Create(f, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = dir == "right" and UDim2.new(-1, 0, 0, 0) or UDim2.new(1, 0, 0, 0)}):Play() 
    local tw = TS:Create(t, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}) 
    tw:Play() 
    tw.Completed:Connect(function() f.Visible = false end) 
end

