local function c(cls, p, pr) 
    local v = Instance.new(cls) 
    if pr then for k, v2 in pairs(pr) do pcall(function() v[k] = v2 end) end end 
    if p then v.Parent = p end 
    pcall(function() v.Active = true end) 
    return v 
end

