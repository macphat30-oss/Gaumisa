local function setInvis(state)
    local char = Plr.Character
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then v.Transparency = state and 1 or 0
        elseif v:IsA("Decal") then v.Transparency = state and 1 or 0
        elseif v:IsA("Accessory") then local h = v:FindFirstChild("Handle") if h then h.Transparency = state and 1 or 0 end end
    end
end

