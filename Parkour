local function playRespawnAnimation()
    local style = math.random(1, 3)
    local t = 0
    local conn
    PixelCharacter.Visible = true

    if style == 1 then
        conn = RunService.Heartbeat:Connect(function(dt)
            t = t + dt
            local progress = math.clamp(t / 0.35, 0, 1)
            local scale = math.sin(progress * math.pi * 0.5) * 1.15
            if progress > 0.8 then scale = 1 + (1 - progress) * 0.1 end
            PixelCharacter.Size = UDim2.new(0, 14 * scale, 0, 22 * scale)
            
            if math.floor(t * 25) % 2 == 0 then
                Body.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
            else
                Body.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            end

            if progress >= 1 then
                conn:Disconnect()
                PixelCharacter.Size = UDim2.new(0, 14, 0, 22)
                Body.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                targetRotation = 0
                PixelCharacter.Rotation = 0
                isDead = false
            end
        end)
    elseif style == 2 then
        local startYOffset = posY - 40
        local targetY = posY
        posY = startYOffset
        
        conn = RunService.Heartbeat:Connect(function(dt)
            t = t + dt
            local progress = math.clamp(t / 0.3, 0, 1)
            posY = startYOffset + (targetY - startYOffset) * (1 - (1 - progress)^2)
            PixelCharacter.Position = UDim2.new(0, posX, 0, posY)
            PixelCharacter.Size = UDim2.new(0, 14, 0, 22)
            
            if progress >= 1 then
                conn:Disconnect()
                posY = targetY
                squashX = 1.35
                squashY = 0.65
                targetRotation = 0
                PixelCharacter.Rotation = 0
                isDead = false
            end
        end)
    else
        local glow = Instance.new("Frame", Canvas)
        glow.Size = UDim2.new(0, 0, 0, 0)
        glow.Position = UDim2.new(0, posX + 7, 0, posY + 11)
        glow.AnchorPoint = Vector2.new(0.5, 0.5)
        glow.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        glow.BorderSizePixel = 0
        Instance.new("UICorner", glow).CornerRadius = UDim.new(1, 0)
        
        conn = RunService.Heartbeat:Connect(function(dt)
            t = t + dt
            local progress = math.clamp(t / 0.35, 0, 1)
            local size = progress * 60
            glow.Size = UDim2.new(0, size, 0, size)
            glow.BackgroundTransparency = progress
            PixelCharacter.Size = UDim2.new(0, 14 * progress, 0, 22 * progress)

            if progress >= 1 then
                conn:Disconnect()
                glow:Destroy()
                PixelCharacter.Size = UDim2.new(0, 14, 0, 22)
                targetRotation = 0
                PixelCharacter.Rotation = 0
                isDead = false
            end
        end)
    end
end

local function respawnPlayer()
    if isDead or isTransitioning then return end
    isDead = true
    velX, velY = 0, 0
    deathCount = deathCount + 1
    DeathCountText.Text = "💀 " .. deathCount

    local style = math.random(1, 3)
    local t = 0
    local conn

    if style == 1 then
        conn = RunService.Heartbeat:Connect(function(dt)
            t = t + dt
            PixelCharacter.Rotation = PixelCharacter.Rotation + 45
            PixelCharacter.Size = UDim2.new(0, math.max(0, 14 * (1 - t * 3)), 0, math.max(0, 22 * (1 - t * 3)))
            if t >= 0.35 then
                conn:Disconnect()
                spawnPixelParticles(posX, posY)
                posX, posY = activeMapData.spawn.x, activeMapData.spawn.y
                PixelCharacter.Rotation = 0
                PixelCharacter.Position = UDim2.new(0, posX, 0, posY)
                jumpsLeft = maxJumps
                playRespawnAnimation()
            end
        end)
    elseif style == 2 then
        spawnPixelParticles(posX, posY)
        PixelCharacter.Visible = false
        conn = RunService.Heartbeat:Connect(function(dt)
            t = t + dt
            if t >= 0.35 then
                conn:Disconnect()
                posX, posY = activeMapData.spawn.x, activeMapData.spawn.y
                PixelCharacter.Rotation = 0
                PixelCharacter.Position = UDim2.new(0, posX, 0, posY)
                jumpsLeft = maxJumps
                playRespawnAnimation()
            end
        end)
    else
        conn = RunService.Heartbeat:Connect(function(dt)
            t = t + dt
            posY = posY + (220 * dt)
            PixelCharacter.Position = UDim2.new(0, posX, 0, posY)
            PixelCharacter.Rotation = PixelCharacter.Rotation + 25
            PixelCharacter.Size = UDim2.new(0, math.max(0, 14 * (1 - t * 2.5)), 0, math.max(0, 22 * (1 - t * 2.5)))
            
            if t >= 0.35 then
                conn:Disconnect()
                posX, posY = activeMapData.spawn.x, activeMapData.spawn.y
                PixelCharacter.Rotation = 0
                PixelCharacter.Position = UDim2.new(0, posX, 0, posY)
                jumpsLeft = maxJumps
                playRespawnAnimation()
            end
        end)
    end
end

local function triggerJump()
    if isDead or isTransitioning then return end
    if isGrounded or jumpsLeft > 0 then
        if isGrounded then
            velY = firstJumpForce
            isGrounded = false
            jumpsLeft = maxJumps - 1
            squashX = 0.75
            squashY = 1.25
            spawnLightCyanTrail(posX, posY)
        elseif jumpsLeft > 0 then
            velY = secondJumpForce
            jumpsLeft = jumpsLeft - 1
            squashX = 0.65
            squashY = 1.35
            targetRotation = targetRotation + 360 
            spawnDoubleJumpEffect(posX, posY)
            spawnLightCyanTrail(posX, posY)
        end
    end
end

JumpBtn.MouseButton1Down:Connect(triggerJump)
LeftBtn.MouseButton1Down:Connect(function() moveLeft = true end)
LeftBtn.MouseButton1Up:Connect(function() moveLeft = false end)
RightBtn.MouseButton1Down:Connect(function() moveRight = true end)
RightBtn.MouseButton1Up:Connect(function() moveRight = false end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then moveLeft = true end
    if input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then moveRight = true end
    if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then triggerJump() end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then moveLeft = false end
    if input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then moveRight = false end
end)

