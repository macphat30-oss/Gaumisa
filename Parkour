-- LocalScript (PIXEL PARKOUR TROLL EDITION - PHẦN 3/3)
RunService.Heartbeat:Connect(function(dt)
    if not ScreenGui.Parent or not activeMapData or isDead or isTransitioning or gameFinished then return end
    animTime = animTime + dt

    squashX = squashX + (1 - squashX) * math.clamp(dt * 12, 0, 1)
    squashY = squashY + (1 - squashY) * math.clamp(dt * 12, 0, 1)
    PixelCharacter.Rotation = PixelCharacter.Rotation + (targetRotation - PixelCharacter.Rotation) * math.clamp(dt * 15, 0, 1)

    local accel = onIce and 3 or 15
    local targetVelX = 0
    if moveLeft then targetVelX = -moveSpeed end
    if moveRight then targetVelX = moveSpeed end
    velX = velX + (targetVelX - velX) * math.clamp(dt * accel, 0, 1)

    velY = velY + gravity * dt
    local nextX = posX + velX * dt
    local nextY = posY + velY * dt
    local pW, pH = 14, 22

    if velX > 10 then Eye.Position = UDim2.new(0, 6, 0, 2)
    elseif velX < -10 then Eye.Position = UDim2.new(0, 2, 0, 2) end

    if (math.abs(velX) > 20 or not isGrounded) and math.random(1, 2) == 1 then
        spawnLightCyanTrail(posX, posY)
    end

    for _, pt in ipairs(currentPortals) do
        local inner = pt:FindFirstChild("InnerFrame")
        if inner then
            local pulse = (math.sin(animTime * 7) + 1) / 2
            inner.Size = UDim2.new(0, 8 + pulse * 6, 0, 16 + pulse * 8)
            inner.BackgroundTransparency = 0.1 + pulse * 0.3
        end
        pt.Rotation = math.sin(animTime * 3) * 6
    end

    for _, saw in ipairs(currentSaws) do
        saw.Rotation = (saw.Rotation + 360 * dt * 2) % 360
        local curX = saw.Position.X.Offset
        local spd = saw:GetAttribute("Speed")
        local dir = saw:GetAttribute("Dir")

        curX = curX + (dir * spd * dt)
        if curX >= saw:GetAttribute("MaxX") then dir = -1 elseif curX <= saw:GetAttribute("MinX") then dir = 1 end
        saw:SetAttribute("Dir", dir)
        saw.Position = UDim2.new(0, curX, 0, saw.Position.Y.Offset)

        local sx, sy, sz = saw.Position.X.Offset, saw.Position.Y.Offset, saw.Size.X.Offset
        if (nextX + pW > sx + 2) and (nextX < sx + sz - 2) and (nextY + pH > sy + 2) and (nextY < sy + sz - 2) then
            respawnPlayer()
            return
        end
    end

    for _, fb in ipairs(currentFallingBlocks) do
        local curY = fb.Position.Y.Offset
        local triggerX = fb:GetAttribute("TriggerX")
        local isFalling = fb:GetAttribute("IsFalling")
        local isReturning = fb:GetAttribute("IsReturning")

        if not isFalling and not isReturning and math.abs(posX - triggerX) < 20 then
            fb:SetAttribute("IsFalling", true)
        end

        if isFalling then
            curY = curY + (fb:GetAttribute("Speed") * dt)
            if curY >= 180 then
                curY = 180
                fb:SetAttribute("IsFalling", false)
                fb:SetAttribute("IsReturning", true)
            end
        elseif isReturning then
            curY = curY - (40 * dt)
            if curY <= fb:GetAttribute("StartY") then
                curY = fb:GetAttribute("StartY")
                fb:SetAttribute("IsReturning", false)
            end
        end

        fb.Position = UDim2.new(0, fb.Position.X.Offset, 0, curY)
        local fbx, fby = fb.Position.X.Offset, fb.Position.Y.Offset
        if (nextX + pW > fbx) and (nextX < fbx + 18) and (nextY + pH > fby) and (nextY < fby + 18) then
            respawnPlayer()
            return
        end
    end

    for _, l in ipairs(currentLasers) do
        local curY = l.Position.Y.Offset
        local spd = l:GetAttribute("Speed")
        local dir = l:GetAttribute("Dir")

        curY = curY + (dir * spd * dt)
        if curY >= 160 then dir = -1 elseif curY <= 40 then dir = 1 end
        l:SetAttribute("Dir", dir)
        l.Position = UDim2.new(0, l.Position.X.Offset, 0, curY)

        local lx, ly = l.Position.X.Offset, l.Position.Y.Offset
        if (nextX + pW > lx) and (nextX < lx + 4) and (nextY + pH > ly) and (nextY < ly + 50) then
            respawnPlayer()
            return
        end
    end

    for _, t in ipairs(currentTraps) do
        if t:GetAttribute("Moving") then
            local curX = t.Position.X.Offset
            local dir = t:GetAttribute("Dir")
            curX = curX + (dir * 40 * dt)
            if curX >= t:GetAttribute("MaxX") then dir = -1 elseif curX <= t:GetAttribute("MinX") then dir = 1 end
            t:SetAttribute("Dir", dir)
            t.Position = UDim2.new(0, curX, 0, t.Position.Y.Offset)
        end

        if t:GetAttribute("Toggle") then
            t.Visible = (math.sin(animTime * 4) > 0)
        end

        if t.Visible then
            local tx, ty = t.Position.X.Offset, t.Position.Y.Offset
            local tw, th = t.Size.X.Offset, t.Size.Y.Offset
            if (nextX + pW > tx + 2) and (nextX < tx + tw - 2) and (nextY + pH > ty + 2) and (nextY < ty + th) then
                respawnPlayer()
                return
            end
        end
    end

    wasGrounded = isGrounded
    isGrounded = false
    onIce = false

    for _, pf in ipairs(currentPlatforms) do
        local pType = pf:GetAttribute("Type")
        local isStepped = pf:GetAttribute("IsStepped")
        local isActive = pf:GetAttribute("Active")
        local origX = pf:GetAttribute("OrigX")
        local origY = pf:GetAttribute("OrigY")
        local pW_plat = pf.Size.X.Offset

        if pf:GetAttribute("IsFalling") then
            local curY = pf.Position.Y.Offset
            local fallVel = pf:GetAttribute("FallVelY") + gravity * dt * 0.75
            pf:SetAttribute("FallVelY", fallVel)
            curY = curY + fallVel * dt
            pf.Position = UDim2.new(0, pf.Position.X.Offset, 0, curY)

            if curY > 260 and pf.Visible then
                pf.Visible = false
                pf:SetAttribute("IsFalling", false)
                task.delay(1.8, function()
                    if pf and pf.Parent then
                        pf.Position = UDim2.new(0, origX, 0, origY)
                        pf.BackgroundColor3 = Color3.fromRGB(255, 130, 0)
                        pf.Visible = true
                        pf:SetAttribute("IsStepped", false)
                        pf:SetAttribute("Active", true)
                        pf:SetAttribute("FallVelY", 0)
                    end
                end)
            end
        end

        if isActive then
            if (nextX + pW > origX) and (nextX < origX + pW_plat) then
                if (posY + pH <= origY + 5) and (nextY + pH >= origY) then
                    nextY = origY - pH
                    velY = 0
                    isGrounded = true
                    jumpsLeft = maxJumps 
                    targetRotation = 0 

                    if pType == "ice" then onIce = true end

                    if pType == "fake_platform" and not isStepped then
                        pf:SetAttribute("IsStepped", true)
                        pf.BackgroundColor3 = Color3.fromRGB(255, 30, 30)
                        TrollAlertText.Text = "⚠️ BẪY LỪA ĐẢO! Hahaha 😂"
                        
                        task.delay(0.25, function()
                            if pf and pf.Parent then
                                pf:SetAttribute("Active", false)
                                pf.Visible = false
                                task.delay(2.0, function()
                                    if pf and pf.Parent then
                                        pf.Visible = true
                                        pf.BackgroundColor3 = Color3.fromRGB(140, 60, 190)
                                        pf:SetAttribute("IsStepped", false)
                                        pf:SetAttribute("Active", true)
                                    end
                                end)
                            end
                        end)
                    end

                    if pType == "breakable" and not isStepped then
                        pf:SetAttribute("IsStepped", true)
                        pf.BackgroundColor3 = Color3.fromRGB(255, 70, 0)

                        task.delay(0.35, function()
                            if pf and pf.Parent then
                                pf:SetAttribute("Active", false)
                                pf:SetAttribute("IsFalling", true)
                                pf:SetAttribute("FallVelY", 30)
                            end
                        end)
                    end
                end
            end
        end
    end

    if isGrounded and not wasGrounded then
        squashX = 1.35
        squashY = 0.65
        spawnLandingSmoke(posX, posY)
    end

    if not isGrounded then
        LegL.Position = UDim2.new(0, 2, 0, (velY < 0 and 12 or 17))
        LegR.Position = UDim2.new(0, 9, 0, (velY < 0 and 12 or 17))
        LegL.Size = UDim2.new(0, 3, 0, 6)
        LegR.Size = UDim2.new(0, 3, 0, 6)
        Body.Position = UDim2.new(0, 2, 0, 8)
        Body.Size = UDim2.new(0, 10, 0, (velY < 0 and 7 or 9))
        Head.Position = UDim2.new(0, 2, 0, 0)
    elseif math.abs(velX) > 5 then
        local legOffset = math.sin(animTime * 20) * 3.5
        LegL.Position = UDim2.new(0, 2, 0, 16 + legOffset)
        LegR.Position = UDim2.new(0, 9, 0, 16 - legOffset)
        LegL.Size = UDim2.new(0, 3, 0, 6)
        LegR.Size = UDim2.new(0, 3, 0, 6)
        Body.Position = UDim2.new(0, 2, 0, 8)
        Body.Size = UDim2.new(0, 10, 0, 8 + math.abs(legOffset) * 0.2)
        Head.Position = UDim2.new(0, 2, 0, 0)
    else
        local bounce = math.abs(math.sin(animTime * 6)) * 2
        Head.Position = UDim2.new(0, 2, 0, 0 + bounce)
        Body.Position = UDim2.new(0, 2, 0, 8 + bounce)
        Body.Size = UDim2.new(0, 10, 0, 8)
        LegL.Position = UDim2.new(0, 2, 0, 16 + bounce)
        LegL.Size = UDim2.new(0, 3, 0, math.max(2, 6 - bounce))
        LegR.Position = UDim2.new(0, 9, 0, 16 + bounce)
        LegR.Size = UDim2.new(0, 3, 0, math.max(2, 6 - bounce))
    end

    PixelCharacter.Size = UDim2.new(0, 14 * squashX, 0, 22 * squashY)

    for _, pt in ipairs(currentPortals) do
        local px, py = pt.Position.X.Offset, pt.Position.Y.Offset
        if (nextX + pW >= px) and (nextX <= px + 22) and (nextY + pH >= py) and (nextY <= py + 34) then
            local isCorrect = pt:GetAttribute("Correct")
            
            if isCorrect == false then
                TrollAlertText.Text = "😜 DÍNH CỔNG GIẢ RỒI! ĐOÁN XEM AI CHẾT NÀO?"
                respawnPlayer()
                return
            else
                playPortalEnterAnimation(pt, function()
                    currentLevel = currentLevel + 1
                    playMapTransitionAnimation(currentLevel, function()
                        if loadMap(currentLevel) then
                            posX, posY = activeMapData.spawn.x, activeMapData.spawn.y
                            velY = 0
                            jumpsLeft = maxJumps
                            targetRotation = 0
                            PixelCharacter.Position = UDim2.new(0, posX, 0, posY)
                        else
                            gameFinished = true
                            bgMusic:Stop()
                            bgMusic:Destroy()

                            local WinLabel = Instance.new("TextLabel", Canvas)
                            WinLabel.Size = UDim2.new(1, 0, 1, 0)
                            WinLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                            WinLabel.Text = "👑 QUÁ ĐỈNH!\nBẠN ĐÃ VƯỢT QUA TẤT CẢ CÁC BẪY TROLL!"
                            WinLabel.Font = Enum.Font.FredokaOne
                            WinLabel.TextSize = 16
                            WinLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
                            WinLabel.ZIndex = 25
                            task.wait(4)
                            ScreenGui:Destroy()
                        end
                    end)
                end)
                return
            end
        end
    end

    if nextX < 0 then nextX = 0 end
    if nextX > 510 - pW then nextX = 510 - pW end

    if nextY > 230 then
        respawnPlayer()
        return
    end

    posX, posY = nextX, nextY
    PixelCharacter.Position = UDim2.new(0, posX, 0, posY)
end)
