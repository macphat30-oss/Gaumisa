local function createLevelData(lvl)
    math.randomseed(lvl * 1234 + math.random(1, 9999))
    local data = {
        name = "LEVEL " .. lvl,
        spawn = {x = 15, y = 150},
        portals = {}, platforms = {}, traps = {}, lasers = {}, saws = {}, fallingBlocks = {}
    }

    table.insert(data.platforms, {x = 0, y = 180, w = 60, h = 50, type = "normal"})

    if lvl == 1 then
        data.name = "LEVEL 1"
        for i = 1, 4 do
            table.insert(data.platforms, {x = 60 + i * 75, y = 180 - i * 12, w = 50, h = 10, type = "normal"})
        end
        table.insert(data.platforms, {x = 420, y = 120, w = 90, h = 110, type = "normal"})
        table.insert(data.portals, {x = 455, y = 86, correct = true})
    else
        local curX, curY = 60, 180
        local targetX = 425

        while curX < targetX - 55 do
            local dx = math.random(50, 70) 
            local dy = math.random(-30, 25)
            curX = math.clamp(curX + dx, 60, targetX - 45)
            curY = math.clamp(curY + dy, 70, 185)

            local pType = "normal"
            local randType = math.random(1, 100)
            if randType <= 18 then pType = "breakable"
            elseif randType <= 35 and lvl >= 3 then pType = "ice"
            elseif randType <= 50 and lvl >= 4 then pType = "invisible"
            elseif randType <= 65 and lvl >= 3 then pType = "fake_platform"
            end

            local platWidth = math.random(45, 55)
            table.insert(data.platforms, {x = curX, y = curY, w = platWidth, h = 10, type = pType})

            if lvl >= 2 and math.random(1, 100) <= 30 then
                table.insert(data.traps, {
                    x = curX + 12, y = curY - 8, w = 12, h = 8,
                    moving = (lvl >= 6 and math.random(1, 100) <= 25),
                    toggle = (lvl >= 3 and math.random(1, 100) <= 35),
                    minX = curX + 2, maxX = curX + platWidth - 14
                })
            end

            if lvl >= 3 and math.random(1, 100) <= 25 then
                table.insert(data.saws, {
                    x = curX + 10, y = curY - 26, size = 14,
                    minX = curX - 5, maxX = curX + platWidth - 10, speed = math.random(20, 35)
                })
            end

            if lvl >= 4 and math.random(1, 100) <= 30 then
                table.insert(data.fallingBlocks, {
                    x = curX + 15, startY = 0, triggerX = curX + 5, w = 18, h = 18, speed = 160
                })
            end
        end

        if lvl >= 4 and math.random(1, 100) <= 35 then
            table.insert(data.lasers, {
                x = math.random(180, 300), y = math.random(50, 130), w = 4, h = 45, speed = math.random(30, 50)
            })
        end

        local finalY = math.clamp(curY + math.random(-15, 15), 70, 175)
        table.insert(data.platforms, {x = targetX, y = finalY, w = 85, h = 230 - finalY, type = "normal"})
        
        if lvl >= 3 and math.random(1, 100) <= 45 then
            table.insert(data.portals, {x = targetX - 40, y = finalY - 34, correct = false})
            table.insert(data.portals, {x = targetX + 30, y = finalY - 34, correct = true})
        else
            table.insert(data.portals, {x = targetX + 30, y = finalY - 34, correct = true})
        end
    end

    return data
end

local function loadMap(level)
    if level > 100 then return false end
    activeMapData = createLevelData(level)
    LevelText.Text = activeMapData.name
    TrollAlertText.Text = ""

    for _, list in ipairs({currentPlatforms, currentTraps, currentPortals, currentLasers, currentSaws, currentFallingBlocks}) do
        for _, obj in ipairs(list) do obj:Destroy() end
    end
    currentPlatforms, currentTraps, currentPortals, currentLasers, currentSaws, currentFallingBlocks = {}, {}, {}, {}, {}, {}

    for _, p in ipairs(activeMapData.platforms) do
        local pf = Instance.new("Frame", Canvas)
        pf.Position = UDim2.new(0, p.x, 0, p.y)
        pf.Size = UDim2.new(0, p.w, 0, p.h)
        pf.BorderSizePixel = 0
        
        if p.type == "invisible" then
            pf.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
            pf.BackgroundTransparency = 0.85
        elseif p.type == "breakable" then
            pf.BackgroundColor3 = Color3.fromRGB(255, 130, 0)
        elseif p.type == "ice" then
            pf.BackgroundColor3 = Color3.fromRGB(120, 220, 255)
        elseif p.type == "fake_platform" then
            pf.BackgroundColor3 = Color3.fromRGB(140, 60, 190)
        else
            pf.BackgroundColor3 = Color3.fromRGB(140, 60, 190)
        end

        Instance.new("UICorner", pf).CornerRadius = UDim.new(0, 3)
        pf:SetAttribute("OrigX", p.x)
        pf:SetAttribute("OrigY", p.y)
        pf:SetAttribute("Type", p.type)
        pf:SetAttribute("IsStepped", false)
        pf:SetAttribute("Active", true)
        pf:SetAttribute("IsFalling", false)
        pf:SetAttribute("FallVelY", 0)
        table.insert(currentPlatforms, pf)
    end

    for _, t in ipairs(activeMapData.traps) do
        local trap = Instance.new("TextLabel", Canvas)
        trap.Position = UDim2.new(0, t.x, 0, t.y)
        trap.Size = UDim2.new(0, t.w, 0, t.h)
        trap.BackgroundTransparency = 1
        trap.Text = string.rep("▲", math.max(1, math.floor(t.w / 6)))
        trap.Font = Enum.Font.SourceSansBold
        trap.TextSize = 10
        trap.TextColor3 = Color3.fromRGB(255, 40, 40)
        trap:SetAttribute("Moving", t.moving or false)
        trap:SetAttribute("Toggle", t.toggle or false)
        trap:SetAttribute("MinX", t.minX or t.x)
        trap:SetAttribute("MaxX", t.maxX or t.x)
        trap:SetAttribute("Dir", 1)
        table.insert(currentTraps, trap)
    end

    for _, s in ipairs(activeMapData.saws) do
        local saw = Instance.new("TextLabel", Canvas)
        saw.Position = UDim2.new(0, s.x, 0, s.y)
        saw.Size = UDim2.new(0, s.size, 0, s.size)
        saw.BackgroundTransparency = 1
        saw.Text = "⚙️"
        saw.TextSize = s.size
        saw:SetAttribute("MinX", s.minX)
        saw:SetAttribute("MaxX", s.maxX)
        saw:SetAttribute("Speed", s.speed)
        saw:SetAttribute("Dir", 1)
        table.insert(currentSaws, saw)
    end

    for _, fb in ipairs(activeMapData.fallingBlocks) do
        local block = Instance.new("Frame", Canvas)
        block.Position = UDim2.new(0, fb.x, 0, fb.startY)
        block.Size = UDim2.new(0, fb.w, 0, fb.h)
        block.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
        block.BorderSizePixel = 0
        Instance.new("UICorner", block).CornerRadius = UDim.new(0, 4)

        local face = Instance.new("TextLabel", block)
        face.Size = UDim2.new(1, 0, 1, 0)
        face.BackgroundTransparency = 1
        face.Text = "😡"
        face.TextSize = 12

        block:SetAttribute("TriggerX", fb.triggerX)
        block:SetAttribute("StartY", fb.startY)
        block:SetAttribute("Speed", fb.speed)
        block:SetAttribute("IsFalling", false)
        block:SetAttribute("IsReturning", false)
        table.insert(currentFallingBlocks, block)
    end

    for _, l in ipairs(activeMapData.lasers) do
        local laser = Instance.new("Frame", Canvas)
        laser.Position = UDim2.new(0, l.x, 0, l.y)
        laser.Size = UDim2.new(0, l.w, 0, l.h)
        laser.BackgroundColor3 = Color3.fromRGB(255, 0, 50)
        laser.BorderSizePixel = 0
        laser:SetAttribute("Speed", l.speed)
        laser:SetAttribute("Dir", 1)
        table.insert(currentLasers, laser)
    end

    for _, pt in ipairs(activeMapData.portals) do
        local portal = Instance.new("Frame", Canvas)
        portal.Size = UDim2.new(0, 22, 0, 34)
        portal.Position = UDim2.new(0, pt.x, 0, pt.y)
        portal.BackgroundColor3 = Color3.fromRGB(255, 0, 120)
        portal.BorderSizePixel = 0
        Instance.new("UICorner", portal).CornerRadius = UDim.new(0, 10)

        local inner = Instance.new("Frame", portal)
        inner.Name = "InnerFrame"
        inner.AnchorPoint = Vector2.new(0.5, 0.5)
        inner.Position = UDim2.new(0.5, 0, 0.5, 0)
        inner.Size = UDim2.new(0, 12, 0, 22)
        inner.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        inner.BorderSizePixel = 0
        Instance.new("UICorner", inner).CornerRadius = UDim.new(0, 6)

        portal:SetAttribute("Correct", pt.correct)
        table.insert(currentPortals, portal)
    end

    return true
end
