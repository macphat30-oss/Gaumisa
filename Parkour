local function playPortalEnterAnimation(portal, callback)
    isTransitioning = true
    velX, velY = 0, 0
    
    local portalX = portal.Position.X.Offset
    local portalY = portal.Position.Y.Offset
    local targetX = portalX + 4
    local targetY = portalY + 6
    
    local t = 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        t = t + dt
        local p = math.clamp(t / 0.45, 0, 1)
        
        posX = posX + (targetX - posX) * (dt * 15)
        posY = posY + (targetY - posY) * (dt * 15)
        PixelCharacter.Position = UDim2.new(0, posX, 0, posY)
        
        PixelCharacter.Rotation = PixelCharacter.Rotation + 30
        local scale = math.max(0, 1 - p)
        PixelCharacter.Size = UDim2.new(0, 14 * scale, 0, 22 * scale)
        
        if math.random(1, 2) == 1 then
            local pOrb = Instance.new("Frame", Canvas)
            pOrb.Size = UDim2.new(0, 4, 0, 4)
            pOrb.Position = UDim2.new(0, portalX + math.random(2, 18), 0, portalY + math.random(2, 30))
            pOrb.BackgroundColor3 = Color3.fromRGB(255, 100, 220)
            pOrb.BorderSizePixel = 0
            pOrb.ZIndex = 6
            Instance.new("UICorner", pOrb).CornerRadius = UDim.new(1, 0)
            task.delay(0.2, function() pOrb:Destroy() end)
        end
        
        if p >= 1 then
            conn:Disconnect()
            PixelCharacter.Rotation = 0
            PixelCharacter.Size = UDim2.new(0, 14, 0, 22)
            if callback then callback() end
        end
    end)
end

-- 2. HIỆU ỨNG ANIMATION MỞ MAP TIẾP THEO
local function playMapTransitionAnimation(nextLvl, callback)
    local overlay = Instance.new("Frame", Canvas)
    overlay.Size = UDim2.new(1, 0, 1, 0)
    overlay.Position = UDim2.new(-1, 0, 0, 0)
    overlay.BackgroundColor3 = Color3.fromRGB(15, 12, 22)
    overlay.BorderSizePixel = 0
    overlay.ZIndex = 20

    local levelBanner = Instance.new("TextLabel", overlay)
    levelBanner.Size = UDim2.new(1, 0, 1, 0)
    levelBanner.BackgroundTransparency = 1
    levelBanner.Text = "LEVEL " .. nextLvl
    levelBanner.Font = Enum.Font.FredokaOne
    levelBanner.TextSize = 22
    levelBanner.TextColor3 = Color3.fromRGB(255, 215, 0)

    local t = 0
    local phase = 1
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        t = t + dt
        if phase == 1 then
            local p = math.clamp(t / 0.22, 0, 1)
            overlay.Position = UDim2.new(-1 + p, 0, 0, 0)
            if p >= 1 then
                phase = 2
                t = 0
                if callback then callback() end
            end
        elseif phase == 2 then
            if t >= 0.2 then
                phase = 3
                t = 0
            end
        elseif phase == 3 then
            local p = math.clamp(t / 0.22, 0, 1)
            overlay.Position = UDim2.new(p, 0, 0, 0)
            if p >= 1 then
                conn:Disconnect()
                overlay:Destroy()
                isTransitioning = false
            end
        end
    end)
end

