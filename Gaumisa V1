-- Vòng lặp Render 60FPS cho hiệu ứng
local startTime = os.clock()
local connection
connection = RunService.RenderStepped:Connect(function(dt)
    if isEnded then return end
    local elapsed = os.clock() - startTime
    
    uiGradient.Rotation = (elapsed * 350) % 360

    if activeMode == "SHAKE_HEAVY" then
        local beat = elapsed * 20
        txtGaumisa.TextSize = 110 + math.sin(beat) * 22
        txtGaumisa.Rotation = math.sin(beat * 0.5) * 6
    elseif activeMode == "SHAKE_CRAZY" then
        local beat = elapsed * 26
        txtGaumisa.TextSize = 115 + math.cos(beat) * 28
        txtGaumisa.Rotation = math.sin(beat * 0.7) * 9
    elseif activeMode == "FINAL_RHYTHM" then
        local rhythmBeat = elapsed * 8
        txtGaumisa.TextSize = 110 + math.sin(rhythmBeat * 2) * 30
        txtGaumisa.Rotation = math.sin(rhythmBeat) * 3
    end

    local C_HOTPINK  = Color3.fromRGB(255, 0, 128)
    local C_ELECTRIC = Color3.fromRGB(0, 240, 255)
    local C_LIME     = Color3.fromRGB(50, 255, 50)
    local C_YELLOW   = Color3.fromRGB(255, 255, 0)
    local C_PURPLE   = Color3.fromRGB(180, 0, 255)
    local C_CYAN     = Color3.fromRGB(0, 200, 255)
    local C_ORANGE   = Color3.fromRGB(255, 120, 0)

    for r = 1, ROWS do
        for c = 1, COLS do
            local dist = getDistFromCenter(r, c)
            
            if patternMode == 1 then
                local wave = math.sin(c * 0.6 + r * 0.6 - elapsed * 12)
                grid[r][c].BackgroundColor3 = (wave > 0) and C_HOTPINK or C_ELECTRIC
            elseif patternMode == 2 then
                local ring = math.sin(dist * 18 - elapsed * 15)
                grid[r][c].BackgroundColor3 = (ring > 0) and C_PURPLE or C_YELLOW
            elseif patternMode == 3 then
                local rowWave = math.sin(r * 1.0 - elapsed * 18)
                grid[r][c].BackgroundColor3 = (rowWave > 0) and C_LIME or C_CYAN
            elseif patternMode == 4 then
                local colWave = math.sin(c * 1.0 + elapsed * 20)
                grid[r][c].BackgroundColor3 = (colWave > 0) and C_ELECTRIC or C_ORANGE
            else
                local crazy = math.sin(c - r + elapsed * 20)
                grid[r][c].BackgroundColor3 = (crazy > 0) and C_YELLOW or C_PURPLE
            end
        end
    end
end)

