local COLS, ROWS = 36, 20
local PixelContainer = Instance.new("Frame")
PixelContainer.Size = UDim2.new(1, 0, 1, 0)
PixelContainer.BackgroundTransparency = 1
PixelContainer.Parent = MainFrame

local grid = {}
for r = 1, ROWS do
    grid[r] = {}
    for c = 1, COLS do
        local px = Instance.new("Frame")
        px.Size = UDim2.new(1 / COLS, 1, 1 / ROWS, 1)
        px.Position = UDim2.new((c - 1) / COLS, 0, (r - 1) / ROWS, 0)
        px.BorderSizePixel = 0
        px.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        px.Parent = PixelContainer
        grid[r][c] = px
    end
end

local centerR, centerC = ROWS / 2, COLS / 2
local maxRadius = math.sqrt(centerR^2 + centerC^2)

local function getDistFromCenter(r, c)
    return math.sqrt((r - centerR)^2 + (c - centerC)^2) / maxRadius
end

local function playTween(instance, duration, props, style, dir)
    local info = TweenInfo.new(duration, style or Enum.EasingStyle.Exponential, dir or Enum.EasingDirection.Out)
    local t = TweenService:Create(instance, info, props)
    t:Play()
    return t
end

